# Secrets — never commit a client's API key
config.local.json

# Build output. Run `node build.js` to regenerate; the embed carries the live
# API key, so it stays out of history.
webflow/embed.html
webflow/embed-part1.html
webflow/embed-part2.html
preview.html
prototype.html

# iCloud Drive conflict copies. It appends " 2" to a filename when two
# machines touch the same file, which slips past an exact-name ignore — and
# these are build outputs, so they carry the API key.
* [0-9].*
*\ [0-9].*

# Scratch
_*.html
.DS_Store
node_modules/

# Playwright
test-results/
playwright-report/
