# Secrets — never commit a client's API key
config.local.json

# Build output. Run `node build.js` to regenerate.
#
# Whatever is pasteable is the exception: it IS committed, key and all, so the
# paste-ready file is in the repo and nobody has to build to install the form.
# That means webflow/embed.html, and — the day the form outgrows Webflow's
# 50,000-character cap and the build splits it — embed-part1/2.html instead.
# Ignoring the parts would have emptied the repo of anything pasteable at
# exactly the moment someone needed it, since the build deletes embed.html
# when it splits.
#
# That is only safe because this repo is private — if it ever goes public
# again, re-ignore all of them and rotate the key.
preview.html
preview-partner.html
prototype.html

# iCloud Drive conflict copies. It appends " 2" to a filename when two
# machines touch the same file, which slips past an exact-name ignore — and
# these are build outputs, so they carry the API key.
* [0-9].*
*\ [0-9].*

# Scratch
_*.html
.DS_Store
node_modules/

# Playwright
test-results/
playwright-report/
